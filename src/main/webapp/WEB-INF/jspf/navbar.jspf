<a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
<header class="topbar">
    <div class="topbar-inner">
        <c:choose>
            <c:when test="${not empty sessionScope.vendedor}"><c:set var="inicio" value="registroProdutos.jsp"/></c:when>
            <c:otherwise><c:set var="inicio" value="home.jsp"/></c:otherwise>
        </c:choose>
        <a class="brand" href="${inicio}"><img src="img/Logo.png" alt=""><span>CantinaIF</span></a>

        <nav class="nav" aria-label="Principal">
            <c:choose>
                <c:when test="${not empty sessionScope.vendedor}">
                    <a href="registroProdutos.jsp" <c:if test="${pagina == 'produtos'}">aria-current="page"</c:if>>Produtos</a>
                    <a href="pedidos.jsp" <c:if test="${pagina == 'pedidos'}">aria-current="page"</c:if>>Pedidos</a>
                </c:when>
                <c:otherwise>
                    <a href="home.jsp" <c:if test="${pagina == 'home'}">aria-current="page"</c:if>>Vitrine</a>
                    <a href="Carrinho.jsp" <c:if test="${pagina == 'carrinho'}">aria-current="page"</c:if>>Carrinho
                        <span class="badge-carrinho" id="badge-carrinho" aria-label="itens no carrinho"><c:out value="${empty sessionScope.carrinho ? 0 : sessionScope.carrinho.quantidadeTotal}"/></span></a>
                    <a href="meus-pedidos.jsp" <c:if test="${pagina == 'meus-pedidos'}">aria-current="page"</c:if>>Meus pedidos</a>
                </c:otherwise>
            </c:choose>
        </nav>

        <div class="usuario">
            <span class="usuario-nome">
                <c:choose>
                    <c:when test="${not empty sessionScope.vendedor}">Vendedor <c:out value="${sessionScope.vendedor.prontuario}"/></c:when>
                    <c:otherwise>Olá, <c:out value="${sessionScope.comprador.nome}"/></c:otherwise>
                </c:choose>
            </span>
            <form action="logout" method="post">
                <input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>">
                <button type="submit" class="btn btn-ghost">Sair</button>
            </form>
        </div>
    </div>
</header>
