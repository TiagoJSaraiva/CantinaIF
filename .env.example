# Copie para .env (ignorado pelo git) e ajuste. Nunca versione senhas reais.

# Porta HTTP do Tomcat no contêiner (plataformas como Render/Cloud Run injetam PORT sozinhas).
PORT=8080

# ---- Banco de dados ----
# Sem CANTINA_DB_URL a aplicacao usa H2 em memoria com dados de demonstracao (modo demonstracao).
# Para MySQL (docker compose usa estas variaveis para criar o banco e conectar):
MYSQL_DATABASE=cantinaif
MYSQL_USER=cantina
MYSQL_PASSWORD=troque-esta-senha
# Fora do compose, defina diretamente:
# CANTINA_DB_URL=jdbc:mysql://localhost:3306/cantinaif?useSSL=false&serverTimezone=UTC
# CANTINA_DB_USER=cantina
# CANTINA_DB_PASSWORD=troque-esta-senha

# Semeia os dados de demonstracao no boot somente se nao houver nenhum vendedor (nao apaga nada).
CANTINA_SEED_IF_EMPTY=true

# ---- Modo demonstracao (somente H2) ----
# Horas entre restauracoes automaticas da base (padrao 6; 0 desliga).
# CANTINA_DEMO_RESET_HOURS=6

# ---- Tetos do modo demonstracao (0 = sem limite; fora do modo demo nao ha teto por padrao) ----
# CANTINA_MAX_PRODUTOS=60
# CANTINA_MAX_COMPRADORES=200
# CANTINA_MAX_PEDIDOS_ABERTOS=100
# CANTINA_MAX_BYTES_IMAGENS=12582912

# ---- Seguranca ----
# true quando o app e servido por HTTPS: marca o cookie de sessao como Secure.
CANTINA_COOKIE_SECURE=false

# true quando ha um proxy HTTPS na frente (Render, nginx...): o app confia em X-Forwarded-For/Proto
# (IP real no limite de login, redirecionamentos https) somente para conexoes vindas de proxies confiaveis.
CANTINA_BEHIND_PROXY=false
# Regex Java dos IPs de proxy confiaveis (padrao: enderecos privados).
# CANTINA_TRUSTED_PROXIES=10\.\d+\.\d+\.\d+
